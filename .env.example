# This foundation does not support live mode. No keys are required.
VITE_APP_MODE=mock
# Optional server-only token for higher TonAPI read limits. Never use a VITE_ prefix.
# TONAPI_KEY=
# Configure only after hosting SweepDock's own manifest on an approved public HTTPS origin.
# VITE_TONCONNECT_MANIFEST_URL=

# Production wallet identity. Set on Vercel production only; previews use their own host.
# SWEEPDOCK_PUBLIC_HOST=sweepdock.online
