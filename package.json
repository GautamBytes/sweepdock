{
  "name": "sweepdock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite --configLoader runner --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "pnpm build:api && tsc -p packages/core/tsconfig.build.json && vite build --configLoader runner --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:wallet": "playwright test --config playwright.wallet.config.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm test && pnpm test:preflight && pnpm build && pnpm test:api-artifact && pnpm lint",
    "build:api": "node scripts/build-api.mjs",
    "test:api-artifact": "node scripts/check-api-artifact.mjs",
    "test:preflight": "node --test tests/contracts/preflight.test.mjs",
    "test:contracts": "node --test tests/contracts/execution.test.mjs",
    "check:testnet": "node scripts/check-testnet.mjs",
    "capture:contracts": "node scripts/check-testnet.mjs --capture"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@ston-fi/sdk": "2.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@ton/sandbox": "0.44.0",
    "@ton/ton": "16.3.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "license": "MIT"
}
